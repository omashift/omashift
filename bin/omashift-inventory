#!/bin/bash

# Build Omashift's question bank from the live Omarchy keybinding inventory.
#
#   omashift-inventory                    # live system
#   omashift-inventory keybindings.txt    # fixture, for tests
#
# SOURCE: `omarchy-menu-keybindings --print`, the same inventory Omarchy's own
# SUPER+K menu uses. Deliberately NOT `hyprctl -j binds`, which looks like the
# obvious choice and is wrong: 59 described bindings there carry an empty `key`
# AND `keycode == 0`, including every workspace switch, so they cannot be
# identified at all. `--print` renders them correctly ("SUPER + 1 → Switch to
# workspace 1") and carries 224 entries against hyprctl's 203.
# Parsing approach follows keybinding-guide (MIT) which reads the same source.
#
# Line format:  MODIFIERS + KEY <spaces> → Description
# Edge cases the data actually contains:
#   - bare keys with no modifier      "PRINT → Screenshot"
#   - mouse in two spellings          "LEFT MOUSE BUTTON", "mouse_down"
#   - keys containing spaces          "LEFT MOUSE BUTTON"
#
# Filtering rules, each because the raw data violates it:
#   - drop entries with no modifier   (bare media keys: no recall value)
#   - drop mouse bindings             (can't be typed)
#   - drop SUPER + K                  (it opens the answer list; it's the pit stop)
#   - dedupe by combo, keeping first  (ALT+TAB carries two descriptions)

set -euo pipefail

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

# --lua emits a Lua module instead of JSON. The engine runs inside Hyprland's
# Lua sandbox, which has no JSON parser, so the data is handed over as code.
as_lua=0
if [[ ${1:-} == "--lua" ]]; then as_lua=1; shift; fi

source="${1:-}"
if [[ -n $source ]]; then
  raw=$(cat "$source")
else
  raw=$(omarchy-menu-keybindings --print)
fi

printf '%s\n' "$raw" | jq -Rn '
  def trim: sub("^\\s+";"") | sub("\\s+$";"");

  # Canonical modifier order, so a combo string is stable and comparable.
  def order_mods($mods):
    [ (if ($mods | index("SUPER")) then "SUPER" else empty end)
    , (if ($mods | index("CTRL"))  then "CTRL"  else empty end)
    , (if ($mods | index("ALT"))   then "ALT"   else empty end)
    , (if ($mods | index("SHIFT")) then "SHIFT" else empty end)
    ];

  # Hyprland modmask bits, kept so courses can reason about modifier depth.
  def modmask($mods):
    ( (if ($mods | index("SHIFT")) then 1  else 0 end)
    + (if ($mods | index("CTRL"))  then 4  else 0 end)
    + (if ($mods | index("ALT"))   then 8  else 0 end)
    + (if ($mods | index("SUPER")) then 64 else 0 end) );

  [ inputs
    | select(length > 0)
    | capture("^(?<lhs>.*?)\\s+→\\s+(?<description>.*)$") // empty
    | (.lhs | trim)          as $lhs
    | (.description | trim)  as $description
    | ($lhs | split(" + "))  as $parts
    # No " + " means no modifier: a bare key. Excluded.
    | select(($parts | length) > 1)
    | ($parts[0] | split(" ")
        | map(select(. == "SUPER" or . == "CTRL" or . == "SHIFT" or . == "ALT")))
                             as $mods
    | ($parts[-1] | trim)    as $key
    | select(($mods | length) > 0)
    | select($description != "")
    # Mouse in both spellings the data uses.
    | select(($key | test("MOUSE BUTTON")) | not)
    | select(($key | test("^mouse")) | not)
    | { combo:       ((order_mods($mods) + [$key]) | join(" + "))
      , modifiers:   order_mods($mods)
      , modmask:     modmask($mods)
      , key:         $key
      , description: $description
      }
    | select(.combo != "SUPER + K")
  ]
  | reduce .[] as $e ({seen: {}, out: []};
      if .seen[$e.combo] then .
      else .seen[$e.combo] = true | .out += [$e]
      end)
  | .out
' > "$tmp"

if (( as_lua )); then
  jq -r '
    "-- Generated by omashift-inventory --lua. Do not edit.",
    "return {",
    ( .[] | "  { combo = " + (.combo|tostring|@json)
          + ", key = "     + (.key|tostring|@json)
          + ", modmask = " + (.modmask|tostring)
          + ", description = " + (.description|tostring|@json) + " }," ),
    "}"
  ' "$tmp"
else
  cat "$tmp"
fi
